// Counterweight data model (docs/SPEC.md §10).
// Canonical PostgreSQL schema (production / Vercel). The local SQLite schema is
// auto-derived from this file by scripts/make-sqlite-schema.mjs — do not hand-edit that.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // include Vercel's serverless runtime
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection — app runtime
  directUrl = env("DIRECT_URL")   // direct connection — prisma db push / migrations
}

model User {
  id            String    @id @default(cuid())
  participantId String? // research mode (Day 6)
  createdAt     DateTime  @default(now())
  sessions      Session[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  participantId    String? // research mode (Day 6)
  condition        String    @default("effort_aware") // vanilla | refuse | effort_aware (Day 6)
  consentFlags     String? // JSON blob (Day 6)
  awaitingCaveEval Boolean   @default(false) // probe bookkeeping (Day 5)
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  turns            Turn[]
  metric           Metric?
  probes           Probe[]
  tasks            Task[]
  checkpoints      Checkpoint[]
}

model Turn {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  index     Int // order within the session
  role      String // "user" | "assistant"
  content   String

  // persona side (assistant turns)
  mode       String?
  confidence Float?
  isProbe    Boolean @default(false) // Day 5

  // telemetry-judge scores (user turns)
  reasoningDepth Int? // 0..2
  askedToProduce Boolean?
  verifiedClaim  Boolean?
  concededToAi   Boolean?

  // acceptance latency: ms elapsed since the previous assistant turn (user turns)
  latencyMs Int?

  // human "true" mode label for classifier validation (Day 7)
  humanMode String?

  // hint ladder (Day 10): level requested on this user turn (1 concept cue,
  // 2 first step, 3 worked example); null for ordinary turns
  hintLevel Int?

  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Metric {
  id                String   @id @default(cuid())
  sessionId         String   @unique
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  offloadRatio      Float    @default(0) // 0..1, higher = more outsourcing
  verificationRate  Float    @default(0) // 0..1, higher = more independent
  caveRate          Float    @default(0) // 0..1, higher = caves more
  acceptanceLatency Float    @default(0) // seconds, mean time-to-respond
  independenceIndex Float    @default(0) // 0..100 composite
  turnsScored       Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model Probe {
  id         String    @id @default(cuid())
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnId        String? // the AI turn that carried the wrong nudge
  wrongClaim    String
  correctAnswer String? // the accurate version, surfaced in the debrief
  caved         Boolean?
  firedAt    DateTime  @default(now())
  resolvedAt DateTime?

  @@index([sessionId])
}

model Checkpoint {
  id          String           @id @default(cuid())
  sessionId   String
  session     Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        String           @default("immediate") // "immediate" | "retention" (Day 9)
  parentId    String? // retention checks point at the immediate checkpoint they re-test
  dueAt       DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  score       Float? // 0..1 — correct=1, partial=0.5, incorrect=0, averaged
  createdAt   DateTime         @default(now())
  items       CheckpointItem[]

  @@index([sessionId])
}

model CheckpointItem {
  id           String     @id @default(cuid())
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  order        Int
  question     String
  expectedGist String // grading key — never sent to the client
  userAnswer   String?
  verdict      String? // "correct" | "partial" | "incorrect"
  feedback     String?

  @@index([checkpointId])
}

model Task {
  id          String   @id @default(cuid())
  sessionId   String?
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionId])
}
