{
  "name": "counterweight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/make-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:push:sqlite": "node scripts/make-sqlite-schema.mjs && prisma db push --schema prisma/schema.sqlite.prisma",
    "db:studio": "node scripts/make-sqlite-schema.mjs && prisma studio --schema prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^14.2.5",
    "openai": "^4.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5"
  }
}
