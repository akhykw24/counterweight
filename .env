# Non-secret defaults, safe to commit. Secrets (API keys) live in .env.local.
# Local dev uses SQLite (prisma/schema.sqlite.prisma). Prisma CLI reads this file.
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) is configured via Vercel env vars, not committed here:
#   DATABASE_URL = pooled Postgres URL  (app runtime)
#   DIRECT_URL   = direct Postgres URL  (prisma db push / migrations)
