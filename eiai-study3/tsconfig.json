{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@eiai/schema": ["./packages/schema/src/index.ts"],
      "@eiai/fsm": ["./packages/fsm/src/index.ts"],
      "@eiai/stimuli": ["./packages/stimuli/src/index.ts"],
      "@eiai/telemetry": ["./packages/telemetry/src/index.ts"],
      "@eiai/ingest": ["./services/ingest/src/handler.ts"]
    }
  },
  // Node/library code only. The app is checked by its own tsconfig, which adds
  // the DOM lib, the JSX transform and vite/client types; folding those into
  // the root would let a package accidentally depend on `document` and still
  // typecheck.
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/test/**/*.ts",
    "services/*/src/**/*.ts",
    "services/*/api/**/*.ts",
    "services/*/test/**/*.ts",
    "vitest.config.ts"
  ]
}
