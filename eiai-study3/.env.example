# Ingest service. Server-side only -- neither of these may ever appear in a
# client bundle, which is why the app reads no key of any kind (ADR-002).
#
# Set both in the hosting project's environment variables, not in a file that
# could be committed. .env is git-ignored; this example is not, and holds no
# real values.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Supabase *service role* key. Grants insert on public.events. Do not use the
# anon key: row-level security denies it everything, by design.
SUPABASE_SERVICE_KEY=

# Optional. The study app posts to /api/events on its own origin by default,
# which is correct when the app and the function are deployed together. Set
# this only if the ingest lives somewhere else.
# VITE_INGEST_ENDPOINT=
