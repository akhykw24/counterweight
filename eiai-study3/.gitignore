node_modules/
dist/
.turbo/
*.tsbuildinfo

# playwright
test-results/
playwright-report/
blob-report/
.playwright/

# analysis + pipeline artifacts
__pycache__/
*.py[cod]
.venv/
pipeline/out/

# raw data is never committed (docs/STUDY3_SPEC_v3.md section 3)
data/raw/

# Everything under data/ is derived: synthetic logs, projected tables, the
# specification curve. `make paper` rebuilds all of it from the committed seed,
# so committing it would only create a second source of truth that can drift
# from the first.
data/
paper/

.DS_Store
*.log
.env
.env.local
materials/justifications.json
# Per-cell generation cache: derived, provider-keyed, and regenerable. Committing
# it would put a second copy of the stimuli beside the frozen ones.
materials/generation_cache.json
.env

# Compiler output next to sources. A stray handler.js beside handler.ts is not
# just clutter: the deployment entry imports "./handler.js", so a bundler
# resolves the stale artefact instead of the source, and the deployed function
# stops matching the repository. tsc emitted these here once, from a misplaced
# outDir, and they were committed before anyone noticed.
services/*/src/*.js
services/*/api/*.js
packages/*/src/*.js
