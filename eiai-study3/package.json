{
  "name": "eiai-study3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Emotional Warmth as a Peripheral Cue - processing-route displacement in human-AI epistemic interaction (Study 3)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/study/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "tsx packages/schema/scripts/generate-data-dictionary.ts",
    "codegen:check": "tsx packages/schema/scripts/generate-data-dictionary.ts --check",
    "stimuli:generate": "python pipeline/generate.py",
    "stimuli:equivalence": "python pipeline/verify_equivalence.py",
    "stimuli:manifest": "python pipeline/hash_manifest.py",
    "stimuli:check": "python pipeline/verify_equivalence.py && python pipeline/hash_manifest.py --check",
    "coding:export": "python pipeline/verify_components.py export",
    "coding:score": "python pipeline/verify_components.py score",
    "verify": "pnpm typecheck && pnpm test && pnpm codegen:check && pnpm stimuli:check",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@xstate/graph": "^3.0.4",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
